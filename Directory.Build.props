<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Estilo sencillo: usings explícitos y sin anotaciones de nulabilidad -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>AGROCORE - Proyecto DAM</Authors>
    <Product>AGROCORE</Product>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
