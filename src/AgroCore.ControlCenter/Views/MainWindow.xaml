<Window x:Class="AgroCore.ControlCenter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AGROCORE - Centro de Control" Width="1500" Height="900" MinWidth="1150" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= MENÚ LATERAL ================= -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="AGROCORE" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Centro de control" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Usuario y cierre de sesión -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UserRoleText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            <TextBlock x:Name="UserFarmText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="CERRAR SESIÓN" Style="{StaticResource GhostButton}" Margin="0" Height="36" Click="Logout_Click" />
                </StackPanel>

                <StackPanel x:Name="NavPanel">
                    <TextBlock Text="EXPLOTACIÓN" Style="{StaticResource SectionText}" Margin="8,0,0,6" />
                    <RadioButton x:Name="NavDashboard" Content="Panel principal" Tag="&#xE80F;" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMachines" Content="Máquinas" Tag="&#xE804;" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFields" Content="Campos" Tag="&#xE909;" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTasks" Content="Tareas" Tag="&#xE9D5;" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= CONTENIDO ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Panel principal" Style="{StaticResource TitleText}" />
                        <TextBlock x:Name="FarmTitle" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="FarmSelectorPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,20,0">
                            <TextBlock Text="Explotación:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="FarmSelector" Width="240" SelectionChanged="FarmSelector_SelectionChanged" />
                        </StackPanel>
                        <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionText" Text="Conectado" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,18,0" />
                        <TextBlock x:Name="ClockText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Aviso de emergencia -->
            <Border x:Name="EmergencyBanner" Grid.Row="1" Background="#FFB83A33" Padding="22,9" Visibility="Collapsed">
                <TextBlock Foreground="White" FontWeight="SemiBold"
                           Text="⚠  PARADA DE EMERGENCIA ACTIVA — todas las máquinas están detenidas. Use REANUDAR TODAS para continuar." />
            </Border>

            <!-- Página actual -->
            <ContentControl x:Name="PageHost" Grid.Row="2" />

            <!-- Barra de estado: respuesta del servidor a la última orden -->
            <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,6">
                <Grid>
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="Listo" />
                    <TextBlock x:Name="StatsText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
