<UserControl x:Class="AgroCore.ControlCenter.Views.FieldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14,10">
            <TextBlock x:Name="CropsInfo" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FieldsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="330" Margin="0,0,14,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,3" Background="{Binding StatusBrush}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF111714" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding CropText}" FontSize="13" Margin="0,8,0,4" />
                                <Grid>
                                    <ProgressBar Value="{Binding Growth, Mode=OneWay}" Maximum="100" Margin="0,0,44,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GrowthText}" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PlanText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding HarvestText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />

                                <!-- Plan de cultivo -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0"
                                        Visibility="{Binding DataContext.PlanControlsVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox SelectedIndex="{Binding CropChoice, Mode=TwoWay}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="Zanahoria" />
                                                <ComboBoxItem Content="Maíz" />
                                                <ComboBoxItem Content="Tomate" />
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="PLANTAR" Margin="0" Click="Plant_Click" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <CheckBox Content="Resiembra automática" IsChecked="{Binding AutoReplantChoice, Mode=TwoWay}" />
                                            <Button Content="Cancelar plan" HorizontalAlignment="Right" Style="{StaticResource SmallButton}" Margin="0" Click="Cancel_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
