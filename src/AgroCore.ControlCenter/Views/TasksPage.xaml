<UserControl x:Class="AgroCore.ControlCenter.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <CheckBox x:Name="ShowFinished" Content="Erakutsi osatutakoak eta bertan behera utzitakoak" DockPanel.Dock="Right" Click="ShowFinished_Click" />
                <TextBlock x:Name="CountsText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="TasksGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ZEREGINA" Binding="{Binding Id}" Width="90" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="SOROA" Binding="{Binding FieldText}" Width="80" />
                    <DataGridTextColumn Header="MOTA" Binding="{Binding TypeText}" Width="105" />
                    <DataGridTextColumn Header="LABOREA" Binding="{Binding CropText}" Width="85" />
                    <DataGridTemplateColumn Header="EGOERA" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="8,2" Background="{Binding StatusBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF111714" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MAKINA" Binding="{Binding MachineText}" Width="110" />
                    <DataGridTemplateColumn Header="AURRERAPENA" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,0,40,0" />
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ITXARONALDIA / ARRAZOIA" Binding="{Binding BlockReason}" Width="*" />
                    <DataGridTextColumn Header="SORTUA" Binding="{Binding CreatedText}" Width="70" />
                    <DataGridTextColumn Header="AMAIERA" Binding="{Binding CompletedText}" Width="70" />
                    <DataGridTextColumn Header="ETEN." Binding="{Binding Interruptions}" Width="60" />
                    <DataGridTemplateColumn x:Name="CancelColumn" Header="" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Bertan behera" Style="{StaticResource SmallButton}" Click="Cancel_Click"
                                        IsEnabled="{Binding CanCancel}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
