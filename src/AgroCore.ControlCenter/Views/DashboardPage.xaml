<UserControl x:Class="AgroCore.ControlCenter.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="KpiIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="OverlayCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= KPIs ================= -->
        <UniformGrid Columns="6" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="MAKINAK" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiMachines" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="KpiMachinesSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="&#xE804;" Style="{StaticResource KpiIcon}" Foreground="{StaticResource InfoBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="SOROAK" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiFields" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="KpiFieldsSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="&#xE909;" Style="{StaticResource KpiIcon}" Foreground="{StaticResource AccentBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BATEZ BESTEKO BATERIA" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiBattery" Text="—" Style="{StaticResource KpiValue}" />
                        <ProgressBar x:Name="KpiBatteryBar" Maximum="100" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE83F;" Style="{StaticResource KpiIcon}" Foreground="{StaticResource AccentBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="LANEAN" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiWorking" Text="—" Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="KpiWorkingSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="&#xE768;" Style="{StaticResource KpiIcon}" Foreground="{StaticResource AccentBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="KARGATZEN" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiCharging" Text="—" Style="{StaticResource KpiValue}" Foreground="#FF1A9E96" />
                        <TextBlock x:Name="KpiChargingSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="&#xEA93;" Style="{StaticResource KpiIcon}" Foreground="#FF1A9E96" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ERABILGARRI" Style="{StaticResource SectionText}" Margin="0" />
                        <TextBlock x:Name="KpiAvailable" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="KpiAvailableSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource KpiIcon}" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ================= 3D IKUSPEGIA + ESKUINEKO PANELA ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- Hondoa (zerua), saguaren klikak ere jasotzen dituena -->
                    <Border x:Name="SceneHost">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFCFE6F5" Offset="0" />
                                <GradientStop Color="#FFF2F8EE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Viewport3D x:Name="Viewport" ClipToBounds="True" />
                            <Canvas x:Name="LabelLayer" IsHitTestVisible="False" ClipToBounds="True" />
                        </Grid>
                    </Border>

                    <!-- Ikuspegiaren tresna-barra -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Padding="8,6" CornerRadius="8" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Ikuspegi orokorra" Style="{StaticResource SmallButton}" Click="ResetView_Click" />
                            <Button Content="Goiko ikuspegia" Style="{StaticResource SmallButton}" Click="TopView_Click" />
                            <CheckBox x:Name="LabelsCheck" Content="Etiketak" IsChecked="True" Style="{StaticResource OverlayCheck}" Click="ViewOptions_Click" />
                            <CheckBox x:Name="ZonesCheck" Content="Gune erreserbatuak" Style="{StaticResource OverlayCheck}" Click="ViewOptions_Click" />
                            <CheckBox x:Name="FollowCheck" Content="Hautapena jarraitu" Style="{StaticResource OverlayCheck}" Click="ViewOptions_Click" />
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="8,5" CornerRadius="8" Background="#DDFFFFFF">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Text="Arrastatu: biratu  ·  Eskuineko botoia: desplazatu  ·  Gurpila: zooma  ·  Klik makina batean: hautatu" />
                    </Border>

                    <Border x:Name="WaitingPanel" Background="#E6F3F7F1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ustiategia kargatzen..." FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Zerbitzariaren datuen zain" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Eskuineko panela -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hautatutako makina -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="HAUTATUTAKO MAKINA" Style="{StaticResource SectionText}" />
                        <TextBlock x:Name="NoSelectionText" Text="Egin klik makina baten gainean 3D ikuspegian" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="SelName" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelType" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <Border x:Name="SelStatusChip" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="9,3">
                                    <TextBlock x:Name="SelStatus" FontSize="11" FontWeight="SemiBold" Foreground="#FF111714" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Bateria" Style="{StaticResource MutedText}" Margin="0,3" />
                                <Grid Grid.Column="1" Margin="0,3">
                                    <ProgressBar x:Name="SelBatteryBar" Maximum="100" VerticalAlignment="Center" Margin="0,0,44,0" />
                                    <TextBlock x:Name="SelBattery" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Zeregina" Style="{StaticResource MutedText}" Margin="0,3" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SelTask" FontSize="12" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Text="Aurrerapena" Style="{StaticResource MutedText}" Margin="0,3" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,3">
                                    <ProgressBar x:Name="SelProgressBar" Maximum="100" VerticalAlignment="Center" Margin="0,0,44,0" Foreground="{StaticResource InfoBrush}" />
                                    <TextBlock x:Name="SelProgress" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>
                                <TextBlock Grid.Row="3" Text="Abiadura" Style="{StaticResource MutedText}" Margin="0,3" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SelSpeed" FontSize="12" Margin="0,3" />
                                <TextBlock Grid.Row="4" Text="Tenperatura" Style="{StaticResource MutedText}" Margin="0,3" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SelTemperature" FontSize="12" Margin="0,3" />
                                <TextBlock Grid.Row="5" Text="Xehetasuna" Style="{StaticResource MutedText}" Margin="0,3" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SelNote" FontSize="12" Margin="0,3" TextWrapping="Wrap" />
                            </Grid>

                            <WrapPanel x:Name="SelButtons" Margin="0,12,0,0">
                                <Button Content="HASI" Style="{StaticResource SmallButton}" Background="{StaticResource AccentDarkBrush}" Foreground="White" Click="SelCommand_Click" Tag="START" Margin="0,0,4,4" />
                                <Button Content="GELDITU" Style="{StaticResource SmallButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="SelCommand_Click" Tag="STOP" Margin="0,0,4,4" />
                                <Button Content="BERREKIN" Style="{StaticResource SmallButton}" Click="SelCommand_Click" Tag="RESUME" Margin="0,0,4,4" />
                                <Button Content="BASERA" Style="{StaticResource SmallButton}" Background="{StaticResource InfoBrush}" Foreground="White" Click="SelCommand_Click" Tag="RETURN_TO_BASE" Margin="0,0,4,4" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Alertak -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ALERTAK" Style="{StaticResource SectionText}" />
                        <TextBlock x:Name="NoAlertsText" DockPanel.Dock="Top" Text="Alertarik ez" Style="{StaticResource MutedText}" />
                        <ListBox x:Name="AlertsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding LevelBrush}" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= AGINDUAK FLOTA OSOARI ================= -->
        <Border x:Name="FleetCommands" Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
            <DockPanel>
                <TextBlock Text="FLOTAREN KONTROLA" Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button x:Name="EmergencyButton" DockPanel.Dock="Right" Content="⚠  LARRIALDIKO GELDIALDIA" Style="{StaticResource DangerButton}"
                        Margin="0" Padding="18,9" FontSize="13" Click="Emergency_Click" />
                <StackPanel x:Name="GlobalButtons" Orientation="Horizontal">
                    <Button Content="GUZTIAK GELDITU" Style="{StaticResource WarningButton}" Click="StopAll_Click" />
                    <Button Content="GUZTIAK BERREKIN" Click="ResumeAll_Click" />
                    <Button Content="GUZTIAK BASERA" Style="{StaticResource InfoButton}" Click="ReturnAll_Click" />
                </StackPanel>
                <!-- Simulazioaren abiadura: denbora azkartzeko botoiak (Tag = abiadura) -->
                <StackPanel x:Name="SpeedButtons" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="DENBORA" Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="Speed1" Content="x1" Tag="1" Style="{StaticResource GhostButton}" MinWidth="46" Click="Speed_Click" />
                    <Button x:Name="Speed2" Content="x2" Tag="2" Style="{StaticResource GhostButton}" MinWidth="46" Click="Speed_Click" />
                    <Button x:Name="Speed5" Content="x5" Tag="5" Style="{StaticResource GhostButton}" MinWidth="46" Click="Speed_Click" />
                    <Button x:Name="Speed10" Content="x10" Tag="10" Style="{StaticResource GhostButton}" MinWidth="46" Click="Speed_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
