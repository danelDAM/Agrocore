<UserControl x:Class="AgroCore.ControlCenter.Views.MachinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="MachinesGrid" SelectionChanged="MachinesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MAKINA" Binding="{Binding Name}" Width="110" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="MOTA" Binding="{Binding TypeText}" Width="145" />
                    <DataGridTextColumn Header="EGOERA" Binding="{Binding StatusText}" Width="160" />
                    <DataGridTemplateColumn Header="BATERIA" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100" Foreground="{Binding BatteryBrush}" Margin="0,0,40,0" />
                                    <TextBlock Text="{Binding BatteryText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ZEREGINA" Binding="{Binding TaskText}" Width="125" />
                    <DataGridTextColumn Header="AURRER." Binding="{Binding ProgressText}" Width="70" />
                    <DataGridTextColumn Header="ABIADURA" Binding="{Binding SpeedText}" Width="80" />
                    <DataGridTextColumn Header="TENP." Binding="{Binding TemperatureText}" Width="60" />
                    <DataGridTemplateColumn x:Name="ActionsColumn" Header="AGINDUAK" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="HASI" Tag="START" Style="{StaticResource SmallButton}" Click="Command_Click" />
                                    <Button Content="GELDITU" Tag="STOP" Style="{StaticResource SmallButton}" Click="Command_Click" />
                                    <Button Content="BERREKIN" Tag="RESUME" Style="{StaticResource SmallButton}" Click="Command_Click" />
                                    <Button Content="BASERA" Tag="RETURN_TO_BASE" Style="{StaticResource SmallButton}" Click="Command_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="XEHETASUNA" Binding="{Binding Note}" Width="320" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Makinaren fitxa -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="FITXA TEKNIKOA" Style="{StaticResource SectionText}" />
                <TextBlock x:Name="NoSelection" Text="Hautatu makina bat zerrendatik" Style="{StaticResource MutedText}" />
                <StackPanel x:Name="Details" Visibility="Collapsed">
                    <TextBlock x:Name="DetName" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetModel" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                    <Grid x:Name="DetGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
