<UserControl x:Class="AgroCore.ControlCenter.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="EGUNERATU" Style="{StaticResource GhostButton}" Margin="0" Click="Refresh_Click" />
                    <TextBlock x:Name="PeriodText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Ustiategiaren guztizkoak -->
            <UniformGrid x:Name="TotalsGrid" Columns="6" Margin="0,0,0,14" />

            <!-- Grafikoa: makina bakoitzak osatutako zereginak -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="MAKINA BAKOITZAK OSATUTAKO ZEREGINAK" Style="{StaticResource SectionText}" />
                    <ItemsControl x:Name="ChartList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <Border Grid.Column="1" Height="14" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{Binding Color}" Width="{Binding BarWidth}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Xehetasuna makinaka -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ESTATISTIKAK MAKINAKA" Style="{StaticResource SectionText}" Margin="14,14,0,8" />
                    <DataGrid x:Name="MachinesGrid" MaxHeight="460">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MAKINA" Binding="{Binding Name}" Width="120" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="MOTA" Binding="{Binding TypeText}" Width="130" />
                            <DataGridTextColumn Header="DISTANTZIA" Binding="{Binding Distance}" Width="*" />
                            <DataGridTextColumn Header="AKTIBO" Binding="{Binding Active}" Width="*" />
                            <DataGridTextColumn Header="LANEAN" Binding="{Binding Working}" Width="*" />
                            <DataGridTextColumn Header="MUGIMENDUAN" Binding="{Binding Moving}" Width="*" />
                            <DataGridTextColumn Header="ZAIN" Binding="{Binding Waiting}" Width="*" />
                            <DataGridTextColumn Header="KARGATZEN" Binding="{Binding Charging}" Width="*" />
                            <DataGridTextColumn Header="BATERIA ERAB." Binding="{Binding Battery}" Width="*" />
                            <DataGridTextColumn Header="ZEREGINAK" Binding="{Binding Tasks}" Width="85" />
                            <DataGridTextColumn Header="ETEN." Binding="{Binding Aborted}" Width="70" />
                            <DataGridTextColumn Header="KARGAK" Binding="{Binding Charges}" Width="70" />
                            <DataGridTextColumn Header="ERAGINKORTASUNA" Binding="{Binding Efficiency}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Orokorra (administratzailea bakarrik) -->
            <Border x:Name="GlobalPanel" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ESTATISTIKA OROKORRAK (USTIATEGI GUZTIAK)" Style="{StaticResource SectionText}" Margin="14,14,0,8" />
                    <DataGrid x:Name="GlobalGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USTIATEGIA" Binding="{Binding FarmName}" Width="*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="ZEREGINAK" Binding="{Binding TasksCompleted}" Width="90" />
                            <DataGridTextColumn Header="EREINDAKOAK" Binding="{Binding FieldsSown}" Width="110" />
                            <DataGridTextColumn Header="UZTA BILDUTAKOAK" Binding="{Binding FieldsHarvested}" Width="135" />
                            <DataGridTextColumn Header="DISTANTZIA (KM)" Binding="{Binding DistanceKm, StringFormat=0.00}" Width="120" />
                            <DataGridTextColumn Header="GATAZKAK" Binding="{Binding ConflictsAvoided}" Width="100" />
                            <DataGridTextColumn Header="LARRIALDIAK" Binding="{Binding Emergencies}" Width="100" />
                            <DataGridTextColumn Header="UKATUTAKO SARBIDEAK" Binding="{Binding AccessDenied}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
