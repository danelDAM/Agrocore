<UserControl x:Class="AgroCore.ControlCenter.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="ACTUALIZAR" Style="{StaticResource GhostButton}" Margin="0" Click="Refresh_Click" />
                    <TextBlock x:Name="PeriodText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Totales de la explotación -->
            <UniformGrid x:Name="TotalsGrid" Columns="6" Margin="0,0,0,14" />

            <!-- Gráfico: tareas completadas por máquina -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="TAREAS COMPLETADAS POR MÁQUINA" Style="{StaticResource SectionText}" />
                    <ItemsControl x:Name="ChartList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <Border Grid.Column="1" Height="14" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{Binding Color}" Width="{Binding BarWidth}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Detalle por máquina -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ESTADÍSTICAS POR MÁQUINA" Style="{StaticResource SectionText}" Margin="14,14,0,8" />
                    <DataGrid x:Name="MachinesGrid" MaxHeight="460">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÁQUINA" Binding="{Binding Name}" Width="120" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TypeText}" Width="120" />
                            <DataGridTextColumn Header="DISTANCIA" Binding="{Binding Distance}" Width="*" />
                            <DataGridTextColumn Header="ACTIVA" Binding="{Binding Active}" Width="*" />
                            <DataGridTextColumn Header="TRABAJANDO" Binding="{Binding Working}" Width="*" />
                            <DataGridTextColumn Header="EN MARCHA" Binding="{Binding Moving}" Width="*" />
                            <DataGridTextColumn Header="ESPERANDO" Binding="{Binding Waiting}" Width="*" />
                            <DataGridTextColumn Header="CARGANDO" Binding="{Binding Charging}" Width="*" />
                            <DataGridTextColumn Header="BATERÍA USADA" Binding="{Binding Battery}" Width="*" />
                            <DataGridTextColumn Header="TAREAS" Binding="{Binding Tasks}" Width="70" />
                            <DataGridTextColumn Header="INTERR." Binding="{Binding Aborted}" Width="70" />
                            <DataGridTextColumn Header="CARGAS" Binding="{Binding Charges}" Width="70" />
                            <DataGridTextColumn Header="EFICIENCIA" Binding="{Binding Efficiency}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Global (solo administrador) -->
            <Border x:Name="GlobalPanel" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ESTADÍSTICAS GLOBALES (TODAS LAS EXPLOTACIONES)" Style="{StaticResource SectionText}" Margin="14,14,0,8" />
                    <DataGrid x:Name="GlobalGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EXPLOTACIÓN" Binding="{Binding FarmName}" Width="*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="TAREAS" Binding="{Binding TasksCompleted}" Width="90" />
                            <DataGridTextColumn Header="SEMBRADOS" Binding="{Binding FieldsSown}" Width="100" />
                            <DataGridTextColumn Header="COSECHADOS" Binding="{Binding FieldsHarvested}" Width="100" />
                            <DataGridTextColumn Header="DISTANCIA (KM)" Binding="{Binding DistanceKm, StringFormat=0.00}" Width="120" />
                            <DataGridTextColumn Header="CONFLICTOS" Binding="{Binding ConflictsAvoided}" Width="100" />
                            <DataGridTextColumn Header="EMERGENCIAS" Binding="{Binding Emergencies}" Width="100" />
                            <DataGridTextColumn Header="ACCESOS DENEGADOS" Binding="{Binding AccessDenied}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
